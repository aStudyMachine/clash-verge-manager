{
  "name": "clash-subscription-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Clash Verge 独立订阅配置管理器",
  "author": "aStudyMachine",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/desktop/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:file": "node --import tsx --test",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "prepare-runtime": "node scripts/prepare-runtime.mjs",
    "package": "npm run prepare-runtime && npm run build && electron-builder --win zip --x64 --publish never"
  },
  "dependencies": {
    "ipaddr.js": "2.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "io.github.astudymachine.clashmanager",
    "productName": "Clash 订阅管理器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "manager-resources"
      }
    ],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    },
    "artifactName": "ClashManager-${version}-win-${arch}.${ext}"
  }
}
